ENVIRONMENT=development
DEBUG=true
APP_NAME="Galaxy ERP"

# Conexiones a PostgreSQL (reemplazar con credenciales seguras en producción)
CONTROL_DB_URL=postgresql+asyncpg://erp_app:erp_app_pass@127.0.0.1:5432/erp_control
CONTROL_DB_OWNER_URL=postgresql+asyncpg://erp_owner:erp_owner_pass@127.0.0.1:5432/erp_control

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Seguridad JWT (Generar clave aleatoria de al menos 32 caracteres)
JWT_SECRET_KEY=cambiar-por-clave-secreta-de-al-menos-32-caracteres-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Zona Horaria oficial
TIMEZONE=America/Caracas
