# Etapa 1: Constructor de dependencias
FROM docker.io/library/python:3.14-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY app ./app
COPY cli ./cli
RUN pip install --no-cache-dir --upgrade pip && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels .


# Etapa 2: Imagen final para producción
FROM docker.io/library/python:3.14-slim

WORKDIR /app

# Dependencias de tiempo de ejecución para WeasyPrint y utilidades
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    fonts-dejavu-core \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiar wheels e instalar dependencias a nivel de sistema
COPY --from=builder /build/wheels /wheels
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels

# Crear usuario de servicio no privilegiado
RUN useradd -m -u 1000 -s /bin/bash erp
USER erp

# Copiar código de aplicación y configuración de migraciones
COPY --chown=erp:erp alembic.ini alembic_control.ini /app/
COPY --chown=erp:erp app /app/app
COPY --chown=erp:erp cli /app/cli
COPY --chown=erp:erp migrations /app/migrations
COPY --chown=erp:erp migrations_control /app/migrations_control

ENV PYTHONPATH="/app"
ENV PATH="/home/erp/.local/bin:${PATH}"
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]
