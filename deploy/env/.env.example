# Entorno y aplicación
ENVIRONMENT=production
DEBUG=false
APP_NAME="Galaxy ERP"

# Bases de datos
# PgBouncer (6432) con rol de aplicación (sin DDL)
CONTROL_DB_URL=postgresql+asyncpg://erp_app:CAMBIAR_PASSWORD@127.0.0.1:6432/erp_control
# Conexión directa a PostgreSQL (5432) para erp_owner (migraciones y DDL)
CONTROL_DB_OWNER_URL=postgresql+asyncpg://erp_owner:CAMBIAR_PASSWORD@127.0.0.1:5432/erp_control

# Redis
REDIS_URL=redis://:CAMBIAR_PASSWORD_REDIS@127.0.0.1:6379/0

# Seguridad JWT
JWT_SECRET_KEY=GENERAR_CLAVE_ALEATORIA_DE_AL_MENOS_32_BYTES_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Zona Horaria
TIMEZONE=America/Caracas
